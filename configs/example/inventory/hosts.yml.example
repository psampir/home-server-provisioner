# Home Server Provisioner - Production Inventory
#
# Copy this file to hosts.yml and fill in your own hosts.
# Do not commit hosts.yml - it is gitignored.
#
# A host can appear in multiple groups if it serves multiple roles.
# All hosts under "servers" receive baseline provisioning (common, SSH, users).
#
# Set bootstrap_user per host to the initial SSH user on a fresh install.
# This is only used by 'make bootstrap' - subsequent runs connect as the
# dedicated ansible user.

all:
  children:
    servers:
      children:
        app_servers:
          hosts:
            # my-main-server:
            #   ansible_host: 10.0.0.1
            #   bootstrap_user: jan
            #   vpn_ip: 10.10.0.2          # WireGuard address (managed peer)
        backup_targets:
          hosts:
            # my-local-backup:
            #   ansible_host: 10.0.0.2
            #   bootstrap_user: jan
            #   vpn_ip: 10.10.0.3
            # my-offsite-backup:
            #   ansible_host: 10.0.0.3
            #   bootstrap_user: root
            #   vpn_ip: 10.10.0.4
        vpn_servers:
          hosts:
            # my-vps:
            #   ansible_host: 203.0.113.10
            #   bootstrap_user: root
            #   vpn_ip: 10.10.0.1          # convention: hub gets .1
            #   wireguard_role: hub        # exactly ONE host must set this

# --- Per-host vars ------------------------------------------------------------
# For simple per-host overrides (vpn_ip, wireguard_role, etc.) just inline
# them under the host, as shown above. Use inventory/host_vars/<name>.yml
# only when a single host has a large block of config worth its own file.
