#!/usr/bin/env bash
# hsp-apt - non-interactive package update/upgrade for the OliveTin console.
#
# Usage: hsp-apt check | upgrade | autoremove-check | autoremove
#
# check             refreshes the package lists and prints the simulated upgrade
# upgrade           refreshes, runs a safe upgrade (no removals), autocleans the
#                   cache and reports what still needs a restart
# autoremove-check  prints the simulated autoremove (no package list refresh)
# autoremove        removes unused packages, then autocleans the cache
set -euo pipefail

mode="${1:-}"
case "$mode" in
    check|upgrade|autoremove-check|autoremove) ;;
    *)
        echo "usage: hsp-apt check|upgrade|autoremove-check|autoremove" >&2
        exit 2
        ;;
esac

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=l

apt_opts=(
    -o Dpkg::Options::=--force-confdef
    -o Dpkg::Options::=--force-confold
    -o DPkg::Lock::Timeout=120
)

if [[ "$mode" == "autoremove-check" ]]; then
    echo "== apt-get -s autoremove =="
    apt-get -s "${apt_opts[@]}" autoremove
elif [[ "$mode" == "autoremove" ]]; then
    echo "== apt-get -s autoremove =="
    apt-get -s "${apt_opts[@]}" autoremove

    echo
    echo "== apt-get autoremove =="
    apt-get -y "${apt_opts[@]}" autoremove

    echo
    echo "== apt-get autoclean =="
    apt-get -y autoclean
else
    echo "== apt-get update =="
    apt-get update

    if [[ "$mode" == "check" ]]; then
        echo
        echo "== apt-get -s upgrade =="
        apt-get -s "${apt_opts[@]}" upgrade --with-new-pkgs
    else
        echo
        echo "== apt-get upgrade =="
        apt-get -y "${apt_opts[@]}" upgrade --with-new-pkgs

        echo
        echo "== apt-get autoclean =="
        apt-get -y autoclean
    fi
fi

echo
echo "== needrestart =="
needrestart -b || true

if [[ -f /run/reboot-required ]]; then
    echo
    echo "REBOOT REQUIRED"
    cat /run/reboot-required.pkgs 2>/dev/null || true
fi

health_check() {
    echo
    echo "== dpkg audit =="
    dpkg --audit || true

    echo
    echo "== apt-get check =="
    apt-get check || true

    echo
    echo "== failed units =="
    systemctl --failed --no-pager || true

    if command -v etckeeper >/dev/null 2>&1; then
        echo
        echo "== etckeeper last commit =="
        etckeeper vcs log -1 --format='%h %s' 2>/dev/null || true
    fi
}

health_check
