# SSH_PUBKEY_FILE = $(HOME)/.ssh/id_ed25519.pub

# SSH private key for Ansible (must match the public key above)
# ANSIBLE_PRIVATE_KEY_FILE = $(HOME)/.ssh/id_ed25519

