# SSH public key path (auto-detected if not set)
# SSH_PUBKEY_FILE = $(HOME)/.ssh/id_ed25519.pub

# SSH private key for Ansible (must match the public key above)
# ANSIBLE_PRIVATE_KEY_FILE = $(HOME)/.ssh/id_ed25519

# Test VM resource defaults (Incus uses IEC units: GiB, MiB)
# VM_CPUS         = 2
# VM_MEMORY       = 2GiB
# INCUS_IMAGE     = images:debian/13
# BOOTSTRAP_USER  = testadmin
