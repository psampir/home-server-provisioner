#!/usr/bin/env bash
# hsp-smart - run a short SMART self-test or print disk health.
#
# Usage: hsp-smart short | status [summary|full]
#
#   short            start a short self-test
#   status summary   compact health and the attributes that matter (default)
#   status full      the full smartctl -H -A table, for a wide screen
set -euo pipefail

mode="${1:-status}"
view="${2:-summary}"

case "$mode" in
    short|status) ;;
    *)
        echo "usage: hsp-smart short | status [summary|full]" >&2
        exit 2
        ;;
esac

if [[ "$mode" == "status" ]]; then
    case "$view" in
        summary|full) ;;
        *)
            echo "usage: hsp-smart short | status [summary|full]" >&2
            exit 2
            ;;
    esac
fi

if ! command -v smartctl >/dev/null 2>&1; then
    echo "smartctl is not installed" >&2
    exit 1
fi

mapfile -t devices < <(
    smartctl --scan \
        | sed 's/[[:space:]]*#.*$//; s/[[:space:]]*$//' \
        | sed '/^$/d'
)

if [[ "${#devices[@]}" -eq 0 ]]; then
    echo "no SMART devices found" >&2
    exit 1
fi

for dev in "${devices[@]}"; do
    echo "== ${dev%% *} =="
    # The scan line can contain "-d nvme"; word splitting is intentional.
    # shellcheck disable=SC2086
    if [[ "$mode" == "short" ]]; then
        smartctl -t short ${dev}
    elif [[ "$view" == "full" ]]; then
        smartctl -H -A ${dev}
    else
        smartctl --json -H -A ${dev} 2>/dev/null | python3 -c '
import json
import sys


def raw_value(attr):
    raw = attr.get("raw", {})
    text = str(raw.get("string", "")).strip()
    if text:
        first = text.split()[0]
        if first.isdigit():
            return first
    return raw.get("value", "")


try:
    data = json.load(sys.stdin)
except Exception:
    print("health: unknown (no JSON)")
    raise SystemExit(0)

passed = data.get("smart_status", {}).get("passed")
print("health:", "PASSED" if passed is True else "FAILED" if passed is False else "unknown")

model = data.get("model_name")
if model:
    print("model:", model)

ata = data.get("ata_smart_attributes", {}).get("table", [])
wanted = {
    5: ("reallocated", ""),
    9: ("power_on_hours", ""),
    12: ("power_cycles", ""),
    187: ("reported_uncorrect", ""),
    194: ("temperature", " C"),
    197: ("pending", ""),
    198: ("offline_uncorrectable", ""),
    199: ("crc_errors", ""),
    240: ("head_flying_hours", ""),
    241: ("total_lbas_written", ""),
}
for attr in ata:
    attr_id = attr.get("id")
    if attr_id in wanted:
        label, suffix = wanted[attr_id]
        print(f"{label}: {raw_value(attr)}{suffix}")

nvme = data.get("nvme_smart_health_information_log")
if nvme:
    print("temperature:", nvme.get("temperature", "?"), "C")
    print("percentage_used:", nvme.get("percentage_used", "?"), "%")
    print("available_spare:", nvme.get("available_spare", "?"), "%")
    print("media_errors:", nvme.get("media_errors", "?"))
    print("power_on_hours:", nvme.get("power_on_hours", "?"))
    print("power_cycles:", nvme.get("power_cycles", "?"))

if not ata and not nvme:
    print("attributes: not available")
'
    fi
done
