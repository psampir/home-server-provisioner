# Managed by home-server-provisioner - do not edit manually
# Regenerate with: make ssh-config ENV=<env>
#
# `Host <name>` prefers the WireGuard address for app and backup hosts, so the
# alias works both at home and away. `Host <name>-lan` pins the LAN address
# for transfers that should not go through the VPN hub. The hub uses its
# public address by default; set `local_ssh_config_hub_primary: vpn` to
# reach it over WireGuard and keep `<name>-internet` as the public fallback.

{% for host in groups['servers'] | default([]) | sort %}
{% set hv = hostvars[host] %}
{% set vpn = hv['vpn_ip'] | default('') %}
{% set lan = hv['lan_ip'] | default(hv['ansible_host'] | default(host)) %}
{# The wireguard role asserts exactly one host with wireguard_role=hub. #}
{% set is_hub = hv['wireguard_role'] | default('peer') == 'hub' %}
{% set port = hv['ansible_port'] | default(22) | int %}
{% set hub_public = hv['ansible_host'] %}
{% set hub_primary = vpn if is_hub and (local_ssh_config_hub_primary | default('ansible_host', true)) == 'vpn' and vpn else hub_public %}
Host {{ local_ssh_config_host_prefix }}{{ host }}
    HostName {{ hub_primary if is_hub else (vpn if vpn else lan) }}
    User {{ hv['admin_user_name'] }}
    IdentityFile {{ local_ssh_config_private_key }}
{% if port != 22 %}
    Port {{ port }}
{% endif %}
{% if is_hub and hub_primary != hub_public %}

Host {{ local_ssh_config_host_prefix }}{{ host }}-internet
    HostName {{ hub_public }}
    User {{ hv['admin_user_name'] }}
    IdentityFile {{ local_ssh_config_private_key }}
{% if port != 22 %}
    Port {{ port }}
{% endif %}
{% endif %}
{% if not is_hub and vpn and lan and vpn != lan %}

Host {{ local_ssh_config_host_prefix }}{{ host }}-lan
    HostName {{ lan }}
    User {{ hv['admin_user_name'] }}
    IdentityFile {{ local_ssh_config_private_key }}
{% if port != 22 %}
    Port {{ port }}
{% endif %}
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
