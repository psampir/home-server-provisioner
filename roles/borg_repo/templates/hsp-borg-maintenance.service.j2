# {{ ansible_managed }}
[Unit]
Description=Borg repository maintenance (prune + compact)
After=network-online.target
OnFailure=hsp-notify-failure@%n.service

[Service]
Type=oneshot
User={{ borg_repo_user }}
Group={{ borg_repo_group }}
EnvironmentFile={{ borg_repo_env_path }}
ExecStart={{ borg_repo_maintenance_bin }}
