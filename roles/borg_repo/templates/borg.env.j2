# {{ ansible_managed }}
# Shared borg repository passphrase. Mode 0600. Used by the maintenance
# job for prune/compact and available for manual admin restore/list runs:
#   set -a; . {{ borg_repo_env_path }}; set +a
# Escaped on write; see docs/backups.md for why.
BORG_PASSPHRASE="{{ borg_repo_passphrase | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
