#!/usr/bin/env bash
# {{ ansible_managed }}
# Integrity check for append-only borg repos. Runs as the borg user with
# BORG_PASSPHRASE supplied by the systemd EnvironmentFile. Unlike the
# maintenance pass this reads archive manifests, so it is scheduled
# separately. The monthly timer runs without data verification; the
# quarterly hsp-borg-verify service sets BORG_CHECK_VERIFY_DATA=1 to read
# and hash every chunk. Any failure exits non-zero so the unit's OnFailure=
# hook notifies via hsp-notify.
set -euo pipefail

{% if borg_repo_check_verify_data %}
verify_args=(--verify-data)
{% else %}
verify_args=()
if [ "${BORG_CHECK_VERIFY_DATA:-0}" = "1" ]; then
    verify_args+=(--verify-data)
fi
{% endif %}

{% for r in borg_repo_repos | sort(attribute='repo_path') %}
echo "==> check {{ r.repo_path }}"
borg check{% if borg_repo_check_repository_only %} --repository-only{% endif %} \
    "${verify_args[@]}" "{{ r.repo_path }}"
{% endfor %}

echo "borg check complete."
