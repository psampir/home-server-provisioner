# Managed by Ansible (wireguard role) - do not edit by hand.
[Interface]
Address    = {{ vpn_ip }}/{{ wireguard_subnet_prefix }}
PrivateKey = {{ wireguard_privkey }}
{% if wireguard_peer_manage_dns %}
DNS        = {{ wireguard_peer_dns }}
{% if wireguard_hub_domain is defined and wireguard_hub_domain %}
PostUp     = resolvectl domain {{ wireguard_interface }} "~{{ wireguard_hub_domain }}"
PreDown    = resolvectl domain {{ wireguard_interface }} ""
{% endif %}
{% endif %}

# Hub
[Peer]
PublicKey           = {{ wireguard_hub_pubkey }}
Endpoint            = {{ wireguard_hub_endpoint }}
AllowedIPs          = {{ wireguard_subnet }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
