#!/usr/bin/env bash
# hsp-docker-prune - reclaim unused Docker images and the build cache.
#
# Run after a stack deploy: images whose containers were replaced or removed
# have no reference left, while images used by any existing container (also
# a stopped one) stay. A rollback then pulls the old tag or digest again.
# Volumes, containers and networks are never touched.
#
# Environment:
#   HSP_DOCKER_PRUNE_BUILD_CACHE   1 to prune the BuildKit cache, 0 to skip

set -euo pipefail

BUILD_CACHE="${HSP_DOCKER_PRUNE_BUILD_CACHE:-1}"

echo "hsp-docker-prune: pruning images not used by any container"
docker image prune -a -f

if [[ "${BUILD_CACHE}" == "1" ]]; then
    # The whole cache is regenerable; images are never touched.
    echo "hsp-docker-prune: pruning the build cache"
    docker builder prune -f --all
fi
