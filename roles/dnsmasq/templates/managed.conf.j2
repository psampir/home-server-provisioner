# Managed by Ansible (dnsmasq role) - do not edit by hand.

# --- Upstream resolvers ---
no-resolv
{% for server in dnsmasq_upstream_servers %}
server={{ server }}
{% endfor %}

# --- Local domain ---
domain={{ dnsmasq_domain }}
local=/{{ dnsmasq_domain }}/
expand-hosts

# --- Listening ---
{% for iface in dnsmasq_interfaces %}
interface={{ iface }}
{% endfor %}
# bind-dynamic (not bind-interfaces): only listen on the interfaces above,
# but cope with interfaces that are created after dnsmasq starts (e.g. wg0,
# brought up by wg-quick, or a DHCP LAN NIC whose address is assigned by
# networkd). bind-interfaces refuses to start if any listed interface does
# not yet exist, which breaks startup on boot ("unknown interface wg0").
bind-dynamic

# --- Cache ---
cache-size={{ dnsmasq_cache_size }}
# Don't read /etc/hosts - Debian's default `127.0.1.1 <hostname>` line
# pollutes the local domain with a wrong A record.
no-hosts
{% if dnsmasq_log_queries %}
log-queries
{% endif %}

# --- Address records (takes priority over server= forwarding) ---
{% for entry in dnsmasq_extra_addresses %}
address=/{{ entry.name }}/{{ entry.ip }}
{% endfor %}

# --- Host records ---
{% if dnsmasq_include_inventory_hosts %}
{% for group in dnsmasq_inventory_groups %}
{% for host in groups[group] | default([]) %}
{% set ip = hostvars[host].vpn_ip | default(hostvars[host].ansible_host | default(host)) %}
host-record={{ host }}.{{ dnsmasq_domain }},{{ ip }}
{% endfor %}
{% endfor %}
{% endif %}
{% for entry in dnsmasq_extra_hosts %}
{%   if '.' in entry.name %}
host-record={{ entry.name }},{{ entry.ip }}
{%   else %}
host-record={{ entry.name }}.{{ dnsmasq_domain }},{{ entry.ip }}
{%   endif %}
{% endfor %}
{% if dnsmasq_dhcp_enabled %}

# --- DHCP + Router Advertisement (LAN authority) ---
# Served only on {{ dnsmasq_dhcp_interface }}. Ensure no other DHCP server
# (e.g. the router) is active on this segment.
{% if dnsmasq_dhcp_interface not in dnsmasq_interfaces %}
interface={{ dnsmasq_dhcp_interface }}
{% endif %}
{% if dnsmasq_dhcp_v4.start %}
dhcp-range={{ dnsmasq_dhcp_v4.start }},{{ dnsmasq_dhcp_v4.end }},{{ dnsmasq_dhcp_v4.netmask }},{{ dnsmasq_dhcp_v4.lease }}
{% if dnsmasq_dhcp_v4_gateway %}
dhcp-option=3,{{ dnsmasq_dhcp_v4_gateway }}
{% endif %}
{% if dnsmasq_dhcp_v4_dns %}
dhcp-option=6,{{ dnsmasq_dhcp_v4_dns }}
{% endif %}
{% endif %}
{% for lease in dnsmasq_dhcp_static_leases %}
dhcp-host={{ lease.mac }},{{ lease.ip }}{% if lease.name is defined %},{{ lease.name }}{% endif %}

{% endfor %}
{% if dnsmasq_dhcp_v6_mode != 'off' %}
{% set v6base = dnsmasq_dhcp_v6_prefix.split('/')[0] %}
{% set v6len = (dnsmasq_dhcp_v6_prefix.split('/')[1] if '/' in dnsmasq_dhcp_v6_prefix else '64') %}
# Send Router Advertisements so clients can self-configure (SLAAC) and
# learn this host as their IPv6 router/DNS.
enable-ra
{% if dnsmasq_dhcp_v6_mode == 'slaac' %}
# Stateless: address via SLAAC (RA autonomous flag); DNS/other options via
# stateless DHCPv6. ra-names registers clients' IPv6 in local DNS.
dhcp-range={{ v6base }},ra-stateless,ra-names
{% elif dnsmasq_dhcp_v6_mode == 'dhcpv6' %}
# Stateful: dnsmasq assigns addresses from the pool (RA managed flag).
dhcp-range={{ v6base }}100,{{ v6base }}1ff,{{ v6len }},{{ dnsmasq_dhcp_v6_lease }}
{% elif dnsmasq_dhcp_v6_mode == 'both' %}
# Both: stateful pool plus SLAAC (RA managed + autonomous flags).
dhcp-range={{ v6base }}100,{{ v6base }}1ff,{{ v6len }},slaac,{{ dnsmasq_dhcp_v6_lease }}
{% endif %}
{% endif %}
{% endif %}
