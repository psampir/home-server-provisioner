# {{ ansible_managed }}
# borgmatic configuration for {{ inventory_hostname }}. Rendered from
# roles/borgmatic. The nightly timer runs `borgmatic create` only;
# retention is enforced server-side by the borg_repo role (append-only
# repos forbid client-side pruning).

source_directories:
{% for path in borgmatic_source_directories %}
    - {{ path }}
{% endfor %}

repositories:
{% for repo in borgmatic_repositories %}
{% if repo.url is defined %}
    - path: {{ repo.url }}
      label: {{ repo.label | default(repo.url | basename) }}
{% else %}
    - path: "ssh://{{ borgmatic_remote_user }}@{{ repo.host | default(hostvars[repo.target].vpn_ip) }}{{ hostvars[repo.target].borg_repo_base | default(borgmatic_remote_repo_base) }}/{{ inventory_hostname }}/{{ repo.path }}"
      label: {{ repo.label | default(repo.path) }}
{% endif %}
{% endfor %}

# Passphrase comes from {{ borgmatic_env_path }} (mode 0600), injected as
# BORG_PASSPHRASE by the systemd EnvironmentFile. For manual borgmatic/borg
# runs: `set -a; . {{ borgmatic_env_path }}; set +a` first.
encryption_passphrase: ${BORG_PASSPHRASE}

ssh_command: {{ borgmatic_ssh_command }}
compression: {{ borgmatic_compression }}

{% if borgmatic_exclude_patterns | length > 0 %}
exclude_patterns:
{% for pattern in borgmatic_exclude_patterns %}
    - {{ pattern }}
{% endfor %}

{% endif %}
{# Hook lists: the built-in notification entry (when enabled) followed by
   any user-supplied commands. The key is emitted only if the combined list
   is non-empty, so the default rendering is unchanged. #}
{% set before_everything_cmds = borgmatic_before_everything_commands %}
{% set after_everything_cmds = borgmatic_after_everything_commands %}
{% set before_backup_cmds = borgmatic_before_backup_commands %}
{% set on_error_cmds = ([] if not borgmatic_notify_on_failure else [borgmatic_notify_wrapper_path ~ ' failure']) + borgmatic_on_error_commands %}
{% set after_backup_cmds = ([] if not borgmatic_notify_on_success else [borgmatic_notify_wrapper_path ~ ' success']) + borgmatic_after_backup_commands %}
{% if before_everything_cmds | length > 0 %}
before_everything:
{% for cmd in before_everything_cmds %}
    - "{{ cmd }}"
{% endfor %}
{% endif %}
{% if before_backup_cmds | length > 0 %}
before_backup:
{% for cmd in before_backup_cmds %}
    - "{{ cmd }}"
{% endfor %}
{% endif %}
{% if on_error_cmds | length > 0 %}
on_error:
{% for cmd in on_error_cmds %}
    - "{{ cmd }}"
{% endfor %}
{% endif %}
{% if after_backup_cmds | length > 0 %}
after_backup:
{% for cmd in after_backup_cmds %}
    - "{{ cmd }}"
{% endfor %}
{% endif %}
{% if after_everything_cmds | length > 0 %}
after_everything:
{% for cmd in after_everything_cmds %}
    - "{{ cmd }}"
{% endfor %}
{% endif %}
