# {{ ansible_managed }}
# Borg repository passphrase for {{ inventory_hostname }}. Mode 0600.
# Loaded by the borgmatic systemd unit via EnvironmentFile and referenced
# from config.yaml as ${BORG_PASSPHRASE}. Source it manually before ad-hoc
# borg/borgmatic commands: `set -a; . {{ borgmatic_env_path }}; set +a`.
#
# The value is double-quoted and explicitly escaped. systemd's EnvironmentFile
# parser and a shell `. file` interpret an UNQUOTED value differently: a double
# quote, backslash, dollar sign or backtick is either mangled or breaks the
# shell source. Inside double quotes both consumers agree on \\, \", \$ and \`,
# and a literal single quote needs no escaping at all. This makes every
# printable passphrase safe for the timer and for manual `. file` runs.
BORG_PASSPHRASE="{{ borgmatic_passphrase | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
