# {{ ansible_managed }}
# Borg repository passphrase for {{ inventory_hostname }}. Mode 0600.
# Loaded by the borgmatic systemd unit via EnvironmentFile and referenced
# from config.yaml as ${BORG_PASSPHRASE}. Source it manually before ad-hoc
# borg/borgmatic commands: `set -a; . {{ borgmatic_env_path }}; set +a`.
BORG_PASSPHRASE={{ borgmatic_passphrase }}
