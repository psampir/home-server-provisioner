# {{ ansible_managed }}
[Unit]
Description=Beszel Agent
After=network-online.target
Wants=network-online.target
{% if beszel_agent_requires_mounts %}
RequiresMountsFor={{ beszel_agent_requires_mounts | join(' ') }}
{% endif %}

[Service]
Type=simple
User={{ beszel_agent_user }}
Group={{ beszel_agent_user }}
EnvironmentFile=/etc/beszel-agent.env
ExecStart={{ beszel_agent_bin }}
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths={{ beszel_agent_data_dir }}
{% set groups = ['systemd-journal'] + (['docker'] if beszel_agent_docker else []) + beszel_agent_extra_groups %}
SupplementaryGroups={{ groups | unique | join(' ') }}
{% if beszel_agent_capabilities %}
AmbientCapabilities={{ beszel_agent_capabilities | join(' ') }}
CapabilityBoundingSet={{ beszel_agent_capabilities | join(' ') }}
{% endif %}

[Install]
WantedBy=multi-user.target
