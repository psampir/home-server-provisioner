HUB_URL={{ beszel_agent_hub_url }}
KEY={{ beszel_agent_key }}
TOKEN={{ beszel_agent_token }}
SYSTEM_NAME={{ beszel_agent_system_name }}
DISABLE_SSH=true
DATA_DIR={{ beszel_agent_data_dir }}
LISTEN={{ beszel_agent_listen }}
PACKAGE_UPDATES_INTERVAL={{ beszel_agent_package_updates_interval }}
SMART_DEVICES={{ beszel_agent_smart_devices }}
{% if beszel_agent_smart_exclude %}
EXCLUDE_SMART={{ beszel_agent_smart_exclude }}
{% endif %}
{% if beszel_agent_extra_filesystems %}
EXTRA_FILESYSTEMS={{ beszel_agent_extra_filesystems }}
{% endif %}
{% if beszel_agent_gpu_collector %}
GPU_COLLECTOR={{ beszel_agent_gpu_collector }}
{% endif %}
DOCKER_HOST={{ 'unix:///var/run/docker.sock' if beszel_agent_docker else '' }}
{% if beszel_agent_docker %}
DOCKER_IMAGE_CHECK=false
{% endif %}
