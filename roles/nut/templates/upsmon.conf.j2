# {{ ansible_managed }}
{% for monitor in nut_monitors %}
MONITOR {{ monitor.ups }}@{{ monitor.host }} {{ monitor.powervalue }} {{ monitor.user }} {{ monitor.password }} {{ monitor.role }}
{% endfor %}
MINSUPPLIES {{ nut_min_supplies }}
POLLFREQ {{ nut_poll_freq }}
POLLFREQALERT {{ nut_poll_freq_alert }}
SHUTDOWNCMD "{{ nut_shutdown_command }}"
NOTIFYCMD /usr/sbin/upssched
{% for event, flags in nut_notify_flags.items() %}
NOTIFYFLAG {{ event }} {{ flags }}
{% endfor %}
