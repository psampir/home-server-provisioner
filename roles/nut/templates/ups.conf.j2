# {{ ansible_managed }}
{% for key, value in nut_ups_global_options.items() %}
{{ key }} = {{ value }}
{% endfor %}
{% for ups in nut_ups %}

[{{ ups.name }}]
	driver = "{{ ups.driver }}"
	port = "{{ ups.port }}"
{% if ups.desc is defined and ups.desc %}
	desc = "{{ ups.desc }}"
{% endif %}
{% endfor %}
