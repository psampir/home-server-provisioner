# {{ ansible_managed }}
{% for user in nut_users %}
[{{ user.name }}]
	password = {{ user.password }}
{% if user.actions is defined and user.actions %}
	actions = {{ user.actions }}
{% endif %}
{% if user.instcmds is defined and user.instcmds %}
	instcmds = {{ user.instcmds }}
{% endif %}
{% if user.upsmon is defined and user.upsmon %}
	upsmon {{ user.upsmon }}
{% endif %}
{% endfor %}
