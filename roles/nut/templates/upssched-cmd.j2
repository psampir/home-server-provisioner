#!/bin/sh
# {{ ansible_managed }}
#
# Logs UPS events and enforces a grace period after losing communication
# with the UPS. Low-battery shutdown is handled by upsmon's SHUTDOWNCMD.

set -eu

UPS="{{ nut_ups_name }}@{{ nut_listen_address }}"
GRACE={{ nut_nocomm_grace_seconds }}
POLL={{ nut_nocomm_poll_seconds }}

log() {
    logger -t upssched -- "$*"
}

case "${1:-}" in
    online)
        log "UPS on line power"
        ;;
    onbatt)
        log "UPS on battery"
        ;;
    lowbatt)
        log "UPS battery low; upsmon will shut down"
        ;;
    nocomm)
        log "lost communication with ${UPS}; waiting ${GRACE}s"
        elapsed=0
        while [ "$elapsed" -lt "$GRACE" ]; do
            if status=$(timeout 5 upsc "$UPS" 2>/dev/null); then
                case "$status" in
                    *ups.status*OL*|*ups.status*OB*)
                        log "communication with ${UPS} restored"
                        exit 0
                        ;;
                esac
            fi
            sleep "$POLL"
            elapsed=$((elapsed + POLL))
        done
        log "communication with ${UPS} not restored after ${GRACE}s; shutting down"
        /sbin/shutdown -h now
        ;;
    *)
        log "unknown event: ${1:-}"
        ;;
esac
