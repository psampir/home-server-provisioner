#!/bin/sh
# {{ ansible_managed }}
#
# Logs UPS events, optionally forwards them through nut_notify_command, and
# enforces a grace period after losing communication with the UPS. Low-battery
# shutdown is handled by upsmon through SHUTDOWNCMD.

set -eu

UPS_LIST="{{ nut_ups | map(attribute='name') | join(' ') }}"
GRACE={{ nut_nocomm_grace_seconds }}
POLL={{ nut_nocomm_poll_seconds }}
SHUTDOWN="{{ nut_nocomm_shutdown_command }}"
NOTIFY="{{ nut_notify_command }}"

log() {
    logger -t upssched -- "$*"
}

notify() {
    [ -n "$NOTIFY" ] || return 0
    sh -c "$NOTIFY \"\$1\"" _ "$1" || log "notification command failed"
}

case "${1:-}" in
    online)
        msg="UPS on line power"
        log "$msg"
        notify "$msg"
        ;;
    onbatt)
        msg="UPS on battery"
        log "$msg"
        notify "$msg"
        ;;
    lowbatt)
        msg="UPS battery low; upsmon will shut down"
        log "$msg"
        notify "$msg"
        ;;
    nocomm)
        msg="Lost communication with UPS; waiting ${GRACE}s"
        log "$msg"
        notify "$msg"
        elapsed=0
        while [ "$elapsed" -lt "$GRACE" ]; do
            for ups in $UPS_LIST; do
                if status=$(timeout 5 upsc "$ups" 2>/dev/null); then
                    case "$status" in
                        *ups.status*OL*|*ups.status*OB*)
                            msg="Communication restored with ${ups}"
                            log "$msg"
                            notify "$msg"
                            exit 0
                            ;;
                    esac
                fi
            done
            sleep "$POLL"
            elapsed=$((elapsed + POLL))
        done
        msg="UPS communication not restored after ${GRACE}s; shutting down"
        log "$msg"
        notify "$msg"
        $SHUTDOWN
        ;;
    *)
        log "unknown event: ${1:-}"
        ;;
esac
