# {{ ansible_managed }}
# Read by hsp-docker-health as a POSIX shell fragment. Contains the Gatus
# push token, so the file is 0600.
GATUS_URL="{{ docker_health_gatus_url }}"
ENDPOINT_KEY="{{ docker_health_endpoint_key }}"
GATUS_TOKEN="{{ docker_health_token }}"
GATUS_CA="{{ docker_health_gatus_ca }}"
REQUIRE_HEALTHY="{{ docker_health_require_healthy | join(' ') }}"
REQUIRE_RUNNING="{{ docker_health_require_running | join(' ') }}"
TIMEOUT={{ docker_health_timeout }}
