# Private planning documents
*.priv.md

# Only test-vms.conf is tracked; other *-vms.conf are local-only
scripts/*.conf
!scripts/test-vms.conf

# OS artifacts
.DS_Store

# Editor settings
.vscode/

# Ansible
.ansible/
*.retry

# Local environment overrides
.env

# The compose_deploy conflict fixture intentionally contains a plaintext .env.
!tests/fixtures/compose_deploy/conflict-stack/.env

# Per-environment config trees (each has its own private git repo).
# configs/example/ is the template tracked here; everything else is private.
configs/*
!configs/example/

# WireGuard build artifacts (client .conf + QR codes)
build/

# Test data disks (persistent across test create/destroy cycles).
# Incus attaches these as virtual disks to test VMs so the storage role
# can be exercised end-to-end against a real /dev/disk/by-id/ path.
.test-disks/

