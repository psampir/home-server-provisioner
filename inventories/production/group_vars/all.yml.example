# SSH public key to authorize on the service user.
# Reads from SSH_PUBKEY_FILE env var, or falls back to ~/.ssh/id_ed25519.pub.
service_user_ssh_pubkey: "{{ lookup('file', lookup('env', 'SSH_PUBKEY_FILE') | default('~/.ssh/id_ed25519.pub', true)) }}"

# --- base role ---
