# SSH public key to authorize on the service user.
# Reads from SSH_PUBKEY_FILE env var, or falls back to ~/.ssh/id_ed25519.pub.
service_user_ssh_pubkey: "{{ lookup('file', lookup('env', 'SSH_PUBKEY_FILE') | default('~/.ssh/id_ed25519.pub', true)) }}"

# --- base role ---
# Additional packages to install on all hosts.
# base_packages:
#   - curl
#   - htop
#   - vim

# --- service_user role (Ansible service account) ---
# service_user_name: ansible
# service_user_shell: /bin/bash

# --- ssh_hardening role ---
# ssh_hardening_permit_root_login: "no"
# ssh_hardening_password_authentication: "no"
# ssh_hardening_challenge_response_authentication: "no"
# ssh_hardening_use_pam: "yes"
# ssh_hardening_max_auth_tries: 3
# ssh_hardening_login_grace_time: 30
# ssh_hardening_permit_empty_passwords: "no"
# ssh_hardening_x11_forwarding: "no"

# --- admin_user role (interactive SSH user) ---
# admin_user_name: jan
# admin_user_shell: fish
# admin_user_extra_packages:
#   - fish
#   - zoxide

# --- hostname role ---
# hostname_manage_etc_hosts: true

# --- timezone_locale role ---
# timezone_locale_timezone: UTC
# timezone_locale_locale: en_US.UTF-8
# timezone_locale_extra_locales:
#   - pl_PL.UTF-8

# --- time_sync role ---
# Override only if you don't want the distro's default NTP pool.
# time_sync_ntp_servers:
#   - 0.debian.pool.ntp.org
#   - 1.debian.pool.ntp.org
# time_sync_fallback_ntp_servers:
#   - time.cloudflare.com

# --- journal role ---
# journal_storage: persistent
# journal_max_use: "1G"
# journal_max_retention_sec: "1month"

# --- auto_updates role ---
# auto_updates_origins:
